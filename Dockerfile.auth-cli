FROM node:22-bookworm-slim

ARG CODEX_VERSION=0.144.1
ARG CLAUDE_CODE_VERSION=2.1.207

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git less procps \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g \
      "@openai/codex@${CODEX_VERSION}" \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"

COPY scripts/auth-cli-entrypoint.sh /usr/local/bin/auth-cli-entrypoint
COPY scripts/usage-auth.sh /usr/local/bin/usage-auth
RUN chmod 755 /usr/local/bin/auth-cli-entrypoint /usr/local/bin/usage-auth

ENV HOME=/home/node
ENV CODEX_HOME=/home/node/.codex

USER node
WORKDIR /home/node

ENTRYPOINT ["auth-cli-entrypoint"]
CMD ["tail", "-f", "/dev/null"]

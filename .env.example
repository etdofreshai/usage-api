PORT=3000

# Z.ai (Bearer token)
ZAI_API_KEY=

# OpenRouter (Bearer token)
OPENROUTER_API_KEY=

# OpenAI org admin key (for /v1/organization/costs)
OPENAI_ADMIN_KEY=

# Override credential paths (defaults: $HOME/.claude, $HOME/.codex)
# CLAUDE_CREDENTIALS_PATH=/home/node/.claude/.credentials.json
# CODEX_AUTH_PATH=/home/node/.codex/auth.json

# Polling tuning (seconds)
POLL_FLOOR_SECONDS=60
POLL_TARGET_SECONDS=150
POLL_CEILING_SECONDS=600

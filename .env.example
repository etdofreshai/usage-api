PORT=3000

# ET's CLIProxyAPI server (https://github.com/router-for-me/CLIProxyAPI).
# Claude and Codex usage is now read through its Management API instead of
# this service holding its own OAuth credentials — see README.md.
CLIPROXYAPI_BASE_URL=http://etzminisforumx1pro.lan:8317
CLIPROXYAPI_MANAGEMENT_KEY=

# Optional: only needed when CLIProxyAPI has more than one account per
# provider, or when the defaults below don't match your accounts.
# CLIPROXYAPI_CLAUDE_EMAIL=you@example.com
# CLIPROXYAPI_CLAUDE2_EMAIL=you+second@example.com
CLIPROXYAPI_CODEX_EMAIL=etdofresh@gmail.com
CLIPROXYAPI_CODEX2_EMAIL=etdofresh+dev@gmail.com

# Z.ai (Bearer token)
ZAI_API_KEY=

# OpenRouter (Bearer token)
OPENROUTER_API_KEY=

# OpenAI org admin key (for /v1/organization/costs)
OPENAI_ADMIN_KEY=

# Hard kill switch for the second Codex account, even when CLIProxyAPI has a
# matching CLIPROXYAPI_CODEX2_EMAIL account registered.
# CODEX2_ENABLED=false

# Hard kill switch for the second Claude account, even when
# CLIPROXYAPI_CLAUDE2_EMAIL matches a registered CLIProxyAPI account.
# CLAUDE2_ENABLED=false

# Polling tuning (seconds)
POLL_FLOOR_SECONDS=60
POLL_TARGET_SECONDS=150
POLL_CEILING_SECONDS=600

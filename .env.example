PORT=3000

# Z.ai (Bearer token)
ZAI_API_KEY=

# OpenRouter (Bearer token)
OPENROUTER_API_KEY=

# OpenAI org admin key (for /v1/organization/costs)
OPENAI_ADMIN_KEY=

# Override credential paths (defaults: $HOME/.claude, $HOME/.codex)
# CLAUDE_CREDENTIALS_PATH=/home/node/.claude/.credentials.json
# CODEX_AUTH_PATH=/home/node/.codex/auth.json

# Optional second Claude account (default: $HOME/.claude2/.credentials.json).
# When unset, the account is enabled only if the default file exists at
# startup; otherwise it is disabled and absent from /api/usage. Setting this
# always enables the claude2 poller, so a bad path shows up as an error.
# CLAUDE2_CREDENTIALS_PATH=/home/node/.claude2/.credentials.json

# Polling tuning (seconds)
POLL_FLOOR_SECONDS=60
POLL_TARGET_SECONDS=150
POLL_CEILING_SECONDS=600
